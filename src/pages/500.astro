---
import {getLocale,ui,localPath} from "../utils/i18n";
const locale=getLocale(Astro.url),t=ui[locale];
import Layout from "../layouts/Layout.astro";
import { House, ArrowLeft } from "@lucide/astro";

interface Props {
  error?: unknown;
}

const { error } = Astro.props;

// Sanitize error for display - NEVER expose sensitive server details in production
const displayMessage =
  locale === "zh" ? "处理请求时发生错误，请稍后重试。" : "An unexpected error occurred while processing your request.";

// Log full error server-side for debugging (only visible in server logs)
if (error instanceof Error) {
  console.error("500 Server Error:", {
    message: error.message,
    stack: error.stack,
    timestamp: new Date().toISOString(),
  });
}
---

<Layout
  title={`500 - ${t.error} | ${t.name}`}
  description={t.error}
>
  <div class="min-h-screen flex items-center justify-center px-4 py-20">
    <div class="text-center max-w-2xl mx-auto">
      <!-- Large 500 Number -->
      <h1 class="text-9xl font-bold text-error mb-4 animate-pulse">500</h1>

      <!-- Error Title -->
      <h2 class="text-4xl font-bold mb-4">{t.error}</h2>

      <!-- Error Description -->
      <p class="text-xl mb-8 text-base-content/70">
        {displayMessage}
        <br />
        {locale === "zh" ? "你也可以通过邮箱联系我。" : "Please try again later or get in touch if the problem persists."}
      </p>

      <!-- Divider -->
      <div class="divider"></div>

      <!-- Action Buttons -->
      <div class="flex gap-4 justify-center flex-wrap mt-8">
        <a href={localPath("/",locale)} class="btn btn-primary gap-2">
          <House class="size-5" />
          {t.backHome}
        </a>
        <button onclick="history.back()" class="btn btn-outline gap-2">
          <ArrowLeft class="size-5" />
          {locale === "zh" ? "返回上一页" : "Go Back"}
        </button>
      </div>

      <!-- Note about SSR -->
      <div class="mt-12 p-4 bg-base-200 rounded-lg">
        <p class="text-sm text-base-content/60">
          {locale === "zh" ? "刷新页面或稍后再试。" : "Try refreshing the page or come back later."}
        </p>
      </div>

      <!-- Helpful Links -->
      <div class="mt-8">
        <p class="text-sm text-base-content/60 mb-4">{locale === "zh" ? "需要帮助？" : "Need help?"}</p>
        <div class="flex gap-3 justify-center flex-wrap text-sm">
          <a href={localPath("/sections/contact",locale)} class="link link-hover">{t.contact}</a>
          <span class="text-base-content/30">•</span>
          <a
            href={localPath("/projects",locale)}
            class="link link-hover">{t.projects}</a
          >
          <span class="text-base-content/30">•</span>
          <a
            href="https://github.com/lauroguedes/bloomfolio/issues"
            target="_blank"
            rel="noopener noreferrer"
            class="link link-hover">{locale === "zh" ? "反馈模板问题" : "Report Issue"}</a
          >
        </div>
      </div>
    </div>
  </div>
</Layout>
