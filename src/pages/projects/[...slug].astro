---
import { getCollection } from "astro:content";
export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.filter(entry => !entry.id.startsWith("en/")).map(entry => ({ params: { slug: entry.id.replace(/^en\//, "") }, props: {} }));
}
import { getLocale, localPath, contentId } from "../../utils/i18n";
const locale = getLocale(Astro.url);
import { getEntry, render } from "astro:content";
import ProjectLayout from "../../layouts/ProjectLayout.astro";
import { resolveContentSidebar } from "../../utils/contentSidebar";

// Get the slug from params and fetch the entry
const { slug } = Astro.params;

// Handle the slug
const entry = await getEntry("projects",contentId(slug as string,locale));

// If entry doesn't exist, return 404
if (!entry) {
  return Astro.redirect(localPath("/404",locale));
}

const { Content, headings } = await render(entry);
const generalEntry = await getEntry("general", "index");
const contentSidebar = resolveContentSidebar(
  generalEntry?.data,
  entry.data.contentSidebar
);
---

<ProjectLayout
  title={entry.data.title}
  description={entry.data.description}
  startDate={entry.data.startDate}
  endDate={entry.data.endDate}
  image={entry.data.image}
  skills={entry.data.skills}
  demoLink={entry.data.demoLink}
  sourceLink={entry.data.sourceLink}
  headings={headings}
  contentSidebar={contentSidebar}
>
  <Content />
</ProjectLayout>
